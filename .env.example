# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
# Comma-separated Telegram IDs with admin access.
ADMIN_ID=123456789,987654321
# Private chat for feedback forwarding.
FEEDBACK_CHAT_ID=-1001234567890
# Legacy subscription channel; leave empty to disable the legacy gate.
SUBSCRIPTION_CHANNEL=

# Database Configuration
POSTGRES_USER=voenmeh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=voenmeh
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Keep this in sync with POSTGRES_* values.
DATABASE_URL=postgresql+asyncpg://voenmeh:change_me@db:5432/voenmeh

# Redis Configuration
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@redis:6379/0

# Weather (optional)
OPENWEATHERMAP_API_KEY=

# pgAdmin (local development only)
PGADMIN_DEFAULT_EMAIL=admin@voenmeh.local
PGADMIN_DEFAULT_PASSWORD=change_me

# RabbitMQ / Dramatiq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
DRAMATIQ_BROKER_URL=amqp://guest:guest@rabbitmq:5672/?heartbeat=30&blocked_connection_timeout=300&connection_attempts=5&retry_delay=5

# Application Settings
CHECK_INTERVAL_MINUTES=30

# Worker and image generation
DRAMATIQ_PROCESSES=2
DRAMATIQ_THREADS=4
IMAGE_GENERATION_SEMAPHORE=4
IMAGE_SERVICE_SEMAPHORE=2
GEN_ENQUEUE_POOL=10
IMAGE_CACHE_MAX_MB=750
IMAGE_BROWSER_CONCURRENT_PAGES=2
IMAGE_BROWSER_MAX_AGE_SEC=300
IMAGE_BROWSER_MAX_PAGES=4

# Media paths
MEDIA_PATH=bot/media
SCREENSHOTS_PATH=bot/screenshots

# Timezone
TZ=Europe/Moscow
DB_TIMEZONE=Europe/Moscow

# Alerts (optional)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_API_KEY=
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
PROMETHEUS_URL=

# OpenTelemetry (optional)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=voenmeh-timetable-bot
OTEL_ENVIRONMENT=production
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_HEADERS=

# Optional periodic jobs
ENABLE_IMAGE_CACHE_JOBS=1

# Docker Hub (нужен только для публикации образа: scripts/publish_image.sh).
# В CI эти же значения читаются из .env на раннере; если раннер без .env,
# публикация пропускается, а образ только собирается (проверка Dockerfile).
DOCKER_USERNAME=
DOCKER_PASSWORD=
